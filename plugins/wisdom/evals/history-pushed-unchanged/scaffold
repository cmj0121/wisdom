#!/usr/bin/env bash
set -eu
export GIT_AUTHOR_DATE="2026-01-01T00:00:00Z" GIT_COMMITTER_DATE="2026-01-01T00:00:00Z"
git init -q -b main
git config user.name Eval
git config user.email eval@example.com
git config commit.gpgsign false
save() {
	git add -A
	git commit -qm "$1"
}
echo "# demo" >README.md
save "chore: start"
git checkout -qb feat/work
echo "def alpha(): return 1" >alpha.py
save "feat: add alpha"
git update-ref refs/remotes/origin/feat/work HEAD
echo "def beta(): return 2" >beta.py
save "feat: add beta"
