#!/usr/bin/env bash
# Version integrity checks for the marketplace:
#   1. Every marketplace.json plugin version matches its plugin.json version.
#   2. The marketplace.json top-level version never lags the latest git tag
#      (equal = released, ahead = next release in prep, behind = error).
#   3. A plugin whose files changed since the latest tag carries a new version:
#      an installed copy is re-fetched only when the version moves, so a change
#      without a bump never reaches anyone who already has the plugin.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LATEST_TAG="$(git -C "$REPO_ROOT" tag --sort=-v:refname --list 'v*' 2>/dev/null | head -n1 || true)"

PYTHONDONTWRITEBYTECODE=1 PYTHONSAFEPATH=1 PYTHONPATH="$(cd "$(dirname "$0")" && pwd)" python3 - "$REPO_ROOT" "$LATEST_TAG" <<'PY'
import json, os, subprocess, sys

from _common import bad, error_count, ok, source_path

root = sys.argv[1]
latest_tag = sys.argv[2] if len(sys.argv) > 2 else ""
mk = json.load(open(os.path.join(root, ".claude-plugin", "marketplace.json")))

print("==> Checking marketplace.json <-> plugin.json version sync")
for p in mk["plugins"]:
    name = p["name"]
    mk_ver = p.get("version", "")
    src = source_path(p)
    pj_path = os.path.join(root, src, ".claude-plugin", "plugin.json")
    if not os.path.isfile(pj_path):
        bad(f"{name}: missing {os.path.relpath(pj_path, root)}")
        continue
    pj_ver = json.load(open(pj_path)).get("version", "")
    if mk_ver == pj_ver:
        ok(f"{name} {mk_ver}")
    else:
        bad(f"{name}: marketplace={mk_ver} != plugin.json={pj_ver}")


def semver(v):
    """Leading numeric components of a version/tag, e.g. 'v1.3.1' -> (1, 3, 1)."""
    out = []
    for part in v.lstrip("v").split("."):
        digits = ""
        for ch in part:
            if ch.isdigit():
                digits += ch
            else:
                break
        out.append(int(digits) if digits else 0)
    return tuple(out)


print("==> Checking marketplace version vs latest tag")
mk_version = mk.get("version")
if not mk_version:
    print("  skip: marketplace.json has no top-level 'version'")
elif not latest_tag:
    print("  skip: no 'v*' tags found")
else:
    mv, tv = semver(mk_version), semver(latest_tag)
    if mv == tv:
        ok(f"marketplace version {mk_version} matches latest tag {latest_tag}")
    elif mv > tv:
        ok(f"marketplace version {mk_version} ahead of latest tag {latest_tag} (release pending)")
    else:
        bad(f"marketplace version {mk_version} is behind latest tag {latest_tag}")

print("==> Checking plugins changed since the latest tag were bumped")
if not latest_tag:
    print("  skip: no 'v*' tags found")
else:
    for p in mk["plugins"]:
        name = p["name"]
        src = source_path(p)
        changed = subprocess.run(
            ["git", "-C", root, "diff", "--quiet", latest_tag, "--", src],
        ).returncode != 0
        if not changed:
            ok(f"{name}: unchanged since {latest_tag}")
            continue
        pj_path = os.path.join(root, src, ".claude-plugin", "plugin.json")
        try:
            now = json.load(open(pj_path)).get("version", "")
            shown = subprocess.run(
                ["git", "-C", root, "show", f"{latest_tag}:{src}/.claude-plugin/plugin.json"],
                capture_output=True, text=True, check=True,
            ).stdout
            then = json.loads(shown).get("version", "")
        except (OSError, ValueError, subprocess.CalledProcessError):
            ok(f"{name}: no plugin.json at {latest_tag} to compare with")
            continue
        if semver(now) > semver(then):
            ok(f"{name}: changed since {latest_tag}, bumped {then} -> {now}")
        else:
            bad(f"{name}: files changed since {latest_tag} but the version is still {now}")

if error_count():
    print(f"==> {error_count()} version problem(s) found")
    sys.exit(1)
print("==> All version checks passed")
PY
