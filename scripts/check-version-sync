#!/usr/bin/env bash
# Version integrity checks for the marketplace:
#   1. Every marketplace.json plugin version matches its plugin.json version.
#   2. Every plugin.json version matches its SKILL.md metadata.version.
#   3. The marketplace.json top-level version never lags the latest git tag
#      (equal = released, ahead = next release in prep, behind = error).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LATEST_TAG="$(git -C "$REPO_ROOT" tag --sort=-v:refname --list 'v*' 2>/dev/null | head -n1 || true)"

python3 - "$REPO_ROOT" "$LATEST_TAG" <<'PY'
import json, os, re, sys

root = sys.argv[1]
latest_tag = sys.argv[2] if len(sys.argv) > 2 else ""
mk = json.load(open(os.path.join(root, ".claude-plugin", "marketplace.json")))

GREEN, RED, RESET = "\033[32m", "\033[31m", "\033[0m"
# Quiet by default; WISDOM_VERBOSE=1 restores the per-item PASS lines. See the same
# comment in scripts/test for why an environment variable and not a flag.
WISDOM_VERBOSE = os.environ.get("WISDOM_VERBOSE", "") not in ("", "0")
errors = 0


def ok(msg):
    if WISDOM_VERBOSE:
        print(f"  {GREEN}PASS{RESET} {msg}")


def bad(msg):
    global errors
    print(f"  {RED}FAIL{RESET} {msg}")
    errors += 1


plugins = []

print("==> Checking marketplace.json <-> plugin.json version sync")
for p in mk["plugins"]:
    name = p["name"]
    mk_ver = p.get("version", "")
    src = p["source"][2:] if p["source"].startswith("./") else p["source"]
    pj_path = os.path.join(root, src, ".claude-plugin", "plugin.json")
    if not os.path.isfile(pj_path):
        bad(f"{name}: missing {os.path.relpath(pj_path, root)}")
        continue
    pj_ver = json.load(open(pj_path)).get("version", "")
    plugins.append((name, src, pj_ver))
    if mk_ver == pj_ver:
        ok(f"{name} {mk_ver}")
    else:
        bad(f"{name}: marketplace={mk_ver} != plugin.json={pj_ver}")


def skill_version(path):
    """metadata.version from a SKILL.md YAML frontmatter, or (None, reason)."""
    lines = open(path, encoding="utf-8").read().splitlines()
    if not lines or lines[0].strip() != "---":
        return None, "no YAML frontmatter"
    # `.strip()`, matching scripts/validate's frontmatter(): an exact-match
    # `lines.index("---", 1)` gave a leading-space ' ---' the opposite verdict
    # from the other script reading the same file.
    end = next((i for i, line in enumerate(lines[1:], start=1) if line.strip() == "---"), None)
    if end is None:
        return None, "unterminated YAML frontmatter"
    in_metadata = False
    for line in lines[1:end]:
        if not line.strip():
            continue
        if not in_metadata:
            in_metadata = line.rstrip() == "metadata:"
            continue
        if line[0] not in " \t":
            break  # dedent: the metadata block ended
        m = re.match(r"\s+version:\s*(\S+)", line)
        if m:
            return m.group(1).strip("\"'"), None
    return None, "no metadata.version in YAML frontmatter"


print("==> Checking plugin.json <-> SKILL.md metadata.version sync")
for name, src, pj_ver in plugins:
    sk_path = os.path.join(root, src, "skills", name, "SKILL.md")
    rel = os.path.relpath(sk_path, root)
    if not os.path.isfile(sk_path):
        bad(f"{name}: missing {rel}")
        continue
    sk_ver, reason = skill_version(sk_path)
    if sk_ver is None:
        bad(f"{name}: {rel}: {reason}")
    elif sk_ver == pj_ver:
        ok(f"{name} {sk_ver}")
    else:
        bad(f"{name}: plugin.json={pj_ver} != {rel} metadata.version={sk_ver}")


def semver(v):
    """Leading numeric components of a version/tag, e.g. 'v1.3.1' -> (1, 3, 1)."""
    out = []
    for part in v.lstrip("v").split("."):
        digits = ""
        for ch in part:
            if ch.isdigit():
                digits += ch
            else:
                break
        out.append(int(digits) if digits else 0)
    return tuple(out)


print("==> Checking marketplace version vs latest tag")
mk_version = mk.get("version")
if not mk_version:
    print("  skip: marketplace.json has no top-level 'version'")
elif not latest_tag:
    print("  skip: no 'v*' tags found")
else:
    mv, tv = semver(mk_version), semver(latest_tag)
    if mv == tv:
        ok(f"marketplace version {mk_version} matches latest tag {latest_tag}")
    elif mv > tv:
        ok(f"marketplace version {mk_version} ahead of latest tag {latest_tag} (release pending)")
    else:
        bad(f"marketplace version {mk_version} is behind latest tag {latest_tag}")

if errors:
    print(f"==> {errors} version problem(s) found")
    sys.exit(1)
print("==> All version checks passed")
PY
