#!/usr/bin/env bash
# Structural checks for the marketplace:
#   1. marketplace.json parses and carries its top-level fields.
#   2. Every registered plugin declares its four entry fields, its source
#      directory exists, its plugin.json parses and names the same plugin,
#      and it ships a LICENSE.
#   3. All four check scripts are present and executable.
#
# Deliberately NOT checked here — each is covered by a sibling script, and
# duplicating it would only make one more place to keep in step:
#   plugin.json / SKILL.md presence and version agreement  -> check-version-sync
#   SKILL.md frontmatter, README.md presence               -> validate
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

python3 - "$REPO_ROOT" <<'PY'
import json
import os
import sys

root = sys.argv[1]
marketplace = os.path.join(root, ".claude-plugin", "marketplace.json")

GREEN, RED, RESET = "\033[32m", "\033[31m", "\033[0m"
errors = 0


def ok(msg):
    print(f"  {GREEN}PASS{RESET} {msg}")


def bad(msg):
    global errors
    print(f"  {RED}FAIL{RESET} {msg}")
    errors += 1


def load_json(path):
    """Parsed JSON at `path`, or None when it is missing or malformed."""
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


print("==> Validating marketplace.json")
mk = load_json(marketplace)
if mk is None:
    bad("marketplace.json is not valid JSON")
    sys.exit(1)
ok("marketplace.json is valid JSON")

for field in ("name", "owner", "plugins"):
    if field in mk:
        ok(f"marketplace.json has '{field}' field")
    else:
        bad(f"marketplace.json missing '{field}' field")

plugins = mk.get("plugins", [])
print("")
print(f"==> Found {len(plugins)} plugins")

for entry in plugins:
    name = entry.get("name", "")
    source = entry.get("source", "")

    print("")
    print(f"--- plugin: {name} ---")

    for field in ("name", "description", "version", "source"):
        if entry.get(field, ""):
            ok(f"has '{field}'")
        else:
            bad(f"missing '{field}'")

    plugin_dir = os.path.join(root, source[2:] if source.startswith("./") else source)
    if not os.path.isdir(plugin_dir):
        bad(f"source directory does not exist: {source}")
        continue
    ok("source directory exists")

    pj = load_json(os.path.join(plugin_dir, ".claude-plugin", "plugin.json"))
    if pj is None:
        bad(".claude-plugin/plugin.json is missing or not valid JSON")
    else:
        ok(".claude-plugin/plugin.json is valid JSON")
        if pj.get("name", "") == name:
            ok("plugin.json name matches marketplace.json")
        else:
            bad(f"plugin.json name '{pj.get('name', '')}' != marketplace.json name '{name}'")

    if os.path.isfile(os.path.join(plugin_dir, "LICENSE")):
        ok("LICENSE exists")
    else:
        bad("missing LICENSE")

# The check scripts themselves. Deleting one is invisible to every `files:`
# gated hook — pre-commit builds its candidate list with
# `--diff-filter=ACMRTUXB`, which drops deletions — and a hook whose own entry
# vanishes only fails when it runs unconditionally. Three of the four now do;
# scripts/validate-fixtures stays gated on `^scripts/` for its runtime, so this
# unconditional check is what stands between it and a silent removal.
#
# The list is hardcoded on purpose. Globbing scripts/* would make the check
# vacuously true — a deleted script simply would not be looked for — which is
# the exact blind spot it exists to close.
print("==> Checking the check scripts")
for script in ("test", "check-version-sync", "validate", "validate-fixtures"):
    path = os.path.join(root, "scripts", script)
    if os.access(path, os.X_OK) and os.path.isfile(path):
        ok(f"scripts/{script} is present and executable")
    else:
        bad(f"scripts/{script} is missing or not executable")

print("")
if errors:
    print(f"==> {errors} error(s) found")
    sys.exit(1)
print("==> All checks passed")
PY
