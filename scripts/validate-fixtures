#!/usr/bin/env bash
# Negative fixtures for scripts/validate and scripts/check-skill-spec: break a
# temp copy of the repo one way at a time and assert the check fails with the
# message that names that break. A check that cannot fail proves nothing.
#
# Fixture bodies are literal markdown, so their backticks are data.
# shellcheck disable=SC2016
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Every fixture mutates a shipped skill; with none shipped there is nothing to break.
if ! compgen -G "$REPO_ROOT/plugins/*/skills/*/SKILL.md" >/dev/null; then
	echo "==> No skills to mutate -- skipping validator fixtures"
	exit 0
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
ERRORS=0

SKILLS="plugins/wisdom/skills"
TARGET="$SKILLS/shortcut/SKILL.md"

pass() { printf "  \033[32mPASS\033[0m %s\n" "$1"; }
fail() {
	printf "  \033[31mFAIL\033[0m %s\n" "$1"
	ERRORS=$((ERRORS + 1))
}

fresh_copy() {
	rm -rf "$TMP_DIR/repo"
	mkdir -p "$TMP_DIR/repo"
	cp -R "$REPO_ROOT/.claude-plugin" "$REPO_ROOT/plugins" "$REPO_ROOT/README.md" \
		"$REPO_ROOT/README.zh-TW.md" "$TMP_DIR/repo/"
}

# ghost <name> [shortcut] -- a minimal extra skill in the copy.
ghost() {
	mkdir -p "$TMP_DIR/repo/$SKILLS/$1"
	{
		printf -- '---\nname: %s\ndescription: Does one thing for the fixtures.\n' "$1"
		[ -n "${2:-}" ] && printf 'metadata:\n  shortcut: "%s"\n' "$2"
		printf -- '---\n\n# Ghost\n'
	} >"$TMP_DIR/repo/$SKILLS/$1/SKILL.md"
}

# expect <script> <pass|substring> <label>
expect() {
	local out="$TMP_DIR/out"
	if bash "$REPO_ROOT/scripts/$1" "$TMP_DIR/repo" >"$out" 2>&1; then
		if [ "$2" = pass ]; then pass "$3"; else fail "$3: $1 passed but should have failed"; fi
	elif [ "$2" = pass ]; then
		fail "$3: $1 failed on a copy it should accept"
		sed 's/^/      /' "$out"
	elif grep -qF "$2" "$out"; then
		pass "$3"
	else
		fail "$3: $1 failed, but without \"$2\""
		sed 's/^/      /' "$out"
	fi
	fresh_copy
}

fresh_copy
echo "==> scripts/validate"
expect validate pass "the repo as it stands is accepted"

sed -i.bak 's/"description": "/"description": "Changed. /' "$TMP_DIR/repo/plugins/wisdom/.claude-plugin/plugin.json"
expect validate "description differs" "a plugin.json description drifting from marketplace.json is caught"

sed -i.bak 's/wisdom/sagesse/g' "$TMP_DIR/repo/README.md"
expect validate "never named in README.md prose" "a plugin missing from the README prose is caught"

ghost ghost-a "boo"
ghost ghost-b "boo"
expect validate "magic word 'boo' is claimed by both" "a magic word claimed twice is caught"

ghost ghost
expect validate "skill 'ghost' is missing from the '## Skills' tables" "a skill missing from a README is caught"

rm -rf "$TMP_DIR/repo/$SKILLS/compact"
expect validate "lists 'compact', which no plugin ships" "a README row for an unshipped skill is caught"

sed -i.bak 's/^description: .*/&\nmetadata:\n  shortcut: "dispatch it"/' "$TMP_DIR/repo/$TARGET"
expect validate "but its SKILL.md declares" "a magic word the README does not list is caught"

echo 'Hand off to `wisdom:nope`.' >>"$TMP_DIR/repo/$TARGET"
expect validate "reference 'wisdom:nope' resolves to no skill" "an unresolved skill reference is caught"

printf '\n```text\nopen\n' >>"$TMP_DIR/repo/$TARGET"
expect validate "unterminated code fence" "an unclosed fence in a skill is caught"

printf '\n```text\nopen\n' >>"$TMP_DIR/repo/README.zh-TW.md"
expect validate "README.zh-TW.md: unterminated code fence" "an unclosed fence in a README is caught"

echo "==> scripts/check-skill-spec"
expect check-skill-spec pass "the repo as it stands is accepted"

sed -i.bak 's/^license: MIT$/license: MIT\nversion: 1/' "$TMP_DIR/repo/$TARGET"
expect check-skill-spec "unknown frontmatter key 'version'" "an unknown frontmatter key is caught"

sed -i.bak "s/^description: .*/description: $(printf 'x%.0s' $(seq 1 161))/" "$TMP_DIR/repo/$TARGET"
expect check-skill-spec "over this repo's 160 limit" "a description over 160 characters is caught"

sed -i.bak 's/^description: .*/description: I dispatch skills./' "$TMP_DIR/repo/$TARGET"
expect check-skill-spec "must be third person" "a first-person description is caught"

sed -i.bak 's/^name: shortcut$/name: shortcuts/' "$TMP_DIR/repo/$TARGET"
expect check-skill-spec "does not match its directory" "a name that differs from its directory is caught"

seq 1 101 >>"$TMP_DIR/repo/$TARGET"
expect check-skill-spec "over its 100-line budget" "a body over its line budget is caught"

echo ""
if [ "$ERRORS" -ne 0 ]; then
	echo "==> $ERRORS fixture(s) FAILED"
	exit 1
fi
echo "==> All fixtures passed"
