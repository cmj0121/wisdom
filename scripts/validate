#!/usr/bin/env bash
# Semantic checks for the marketplace:
#   1. Each plugin's description reads the same in marketplace.json and its
#      plugin.json, and the top-level README names every plugin in prose.
#   2. A skill's magic words ('metadata.shortcut', comma-separated) are unique
#      across every skill the marketplace ships.
#   3. Both top-level READMEs list exactly the shipped skills in their
#      '## Skills' tables, each with exactly the magic words it declares, and
#      list no skill that is not shipped.
#   4. A '<plugin>:<skill>' reference to a plugin this marketplace ships
#      resolves to one of its skills.
#   5. Code fences in skills and READMEs are balanced.
#   6. Every route smith writes as `<skill>: <TOKEN>` names a skill, and a token
#      that skill's fenced fixed result line states.
#
# An optional positional argument overrides the repo root, so the fixture
# harness can point the validator at a mutated copy of the repo. --per-commit,
# before or after it, skips only the table comparison in check 3, so a README
# row can land in an earlier commit than its skill; `make test` and CI run the
# full form. Quiet by default; WISDOM_VERBOSE=1 restores the per-item PASS lines.
set -euo pipefail

PER_COMMIT=0
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for arg in "$@"; do
	case "$arg" in
	--per-commit) PER_COMMIT=1 ;;
	*) REPO_ROOT="$(cd "$arg" && pwd)" ;;
	esac
done

PYTHONDONTWRITEBYTECODE=1 PYTHONSAFEPATH=1 PYTHONPATH="$(cd "$(dirname "$0")" && pwd)" python3 - "$REPO_ROOT" "$PER_COMMIT" <<'PY'
import glob
import json
import os
import re
import sys

from _common import bad, error_count, ok, parse_frontmatter, shipped_skills, source_path, split_frontmatter

root = sys.argv[1]
per_commit = sys.argv[2] == "1"

READMES = ("README.md", "README.zh-TW.md")

FENCE_RE = re.compile(r"^\s*(```|~~~)")
TICK_RE = re.compile(r"`([^`]+)`")
REF_RE = re.compile(r"`([a-z0-9-]+):([a-z0-9-]+)`")
ROUTE_RE = re.compile(r"`([a-z0-9-]+): ([A-Z][A-Z_]*)`")
FIXED_LINE_RE = re.compile(r"^\s*[A-Z]+: (.+)$")
TOKEN_RE = re.compile(r"[A-Z][A-Z_]*\b")


def rel(path):
    return os.path.relpath(path, root)


def read(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def unfenced(text):
    """Lines outside code fences, or None when a fence is left open."""
    out, inside = [], False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            inside = not inside
        elif not inside:
            out.append(line)
    return None if inside else out


def fixed_tokens(text):
    """Tokens of the fixed result lines in a skill's code fences, so `AFK: ASK — ...` gives ASK."""
    tokens, inside = set(), False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            inside = not inside
        elif inside and (m := FIXED_LINE_RE.match(line)):
            for alternative in m.group(1).split(" — ")[0].split("|"):
                if t := TOKEN_RE.match(alternative.strip()):
                    tokens.add(t.group())
    return tokens


def shortcut_of(path):
    """The comma-separated metadata.shortcut words of a SKILL.md."""
    front, _ = split_frontmatter(path)
    meta = parse_frontmatter(front).get("metadata") if front else None
    words = meta.get("shortcut") if isinstance(meta, dict) else None
    return [w.strip() for w in (words or "").split(",") if w.strip()]


mk = json.load(open(os.path.join(root, ".claude-plugin", "marketplace.json")))

print("==> Checking plugin descriptions and the README roster")
readme_prose = "\n".join(unfenced(read(os.path.join(root, "README.md"))) or [])
skills = {}  # name -> SKILL.md path
for entry in mk["plugins"]:
    name = entry["name"]
    src = source_path(entry)
    pj = json.load(open(os.path.join(root, src, ".claude-plugin", "plugin.json")))
    if pj.get("description") == entry.get("description"):
        ok(f"{name}: description agrees")
    else:
        bad(f"{name}: description differs between marketplace.json and plugin.json")
    if re.search(rf"\b{re.escape(name)}\b", readme_prose):
        ok(f"{name}: named in README.md")
    else:
        bad(f"{name}: registered in marketplace.json but never named in README.md prose")
for skill, path in shipped_skills(root, mk["plugins"]):
    if skill in skills:
        bad(f"{skill}: shipped by two plugins")
    skills[skill] = path

print("==> Checking magic words are unique")
owner = {}
for skill, path in skills.items():
    for word in shortcut_of(path):
        if word in owner:
            bad(f"magic word '{word}' is claimed by both {owner[word]} and {skill}")
        else:
            owner[word] = skill
            ok(f"{skill}: '{word}'")

print("==> Checking the README skill tables")
for readme in READMES:
    path = os.path.join(root, readme)
    if not os.path.isfile(path):
        bad(f"{readme} is missing")
        continue
    lines = unfenced(read(path))
    if lines is None:
        bad(f"{readme}: unterminated code fence")
        continue
    if per_commit:
        continue
    listed, in_skills = {}, False
    for line in lines:
        if line.startswith("## "):
            in_skills = line.strip() == "## Skills"
        if not in_skills or not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        m = re.fullmatch(r"`([a-z0-9-]+)`", cells[0])
        if m:
            listed[m.group(1)] = TICK_RE.findall(cells[-1])
    for skill, path in skills.items():
        if skill not in listed:
            bad(f"{readme}: skill '{skill}' is missing from the '## Skills' tables")
        elif sorted(listed[skill]) != sorted(shortcut_of(path)):
            bad(
                f"{readme}: '{skill}' lists magic words {listed[skill]},"
                f" but its SKILL.md declares {shortcut_of(path)}"
            )
        else:
            ok(f"{readme}: {skill}")
    for skill in listed:
        if skill not in skills:
            bad(f"{readme}: lists '{skill}', which no plugin ships")

print("==> Checking skill references and code fences")
plugins = {e["name"] for e in mk["plugins"]}
for skill, path in skills.items():
    for doc in [path] + sorted(glob.glob(os.path.join(os.path.dirname(path), "references", "*.md"))):
        lines = unfenced(read(doc))
        if lines is None:
            bad(f"{rel(doc)}: unterminated code fence")
            continue
        for plugin, target in REF_RE.findall("\n".join(lines)):
            if plugin not in plugins:
                continue  # file:line, or another marketplace's plugin
            if target in skills:
                ok(f"{rel(doc)}: {plugin}:{target}")
            else:
                bad(f"{rel(doc)}: reference '{plugin}:{target}' resolves to no skill")

print("==> Checking smith's routes against the skills' fixed lines")
if "smith" in skills:
    routes = ROUTE_RE.findall("\n".join(unfenced(read(skills["smith"])) or []))
    if not routes:
        bad("smith states no routes in the `<skill>: <TOKEN>` form")
    for skill, token in routes:
        if skill not in skills:
            bad(f"smith route '{skill}: {token}': no skill '{skill}'")
        elif token in fixed_tokens(read(skills[skill])):
            ok(f"smith route '{skill}: {token}'")
        else:
            bad(f"smith route '{skill}: {token}': {skill} states no such token in a fixed line")

print("")
if error_count():
    print(f"==> {error_count()} error(s) found")
    sys.exit(1)
print(f"==> All semantic checks passed ({len(skills)} skills)")
PY
