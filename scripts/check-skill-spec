#!/usr/bin/env bash
# Checks every SKILL.md against the Agent Skills standard (agentskills.io).
#
# The standard defines six frontmatter fields. Anything else is a typo or a
# field the author assumed existed, and fails.
#
#   1. Frontmatter carries no key outside those six.
#   2. 'name' obeys the standard's grammar and matches its directory.
#   3. 'description' is present, within limits, third-person, tag-free.
#   4. 'compatibility' and 'metadata' hold the shapes the standard gives
#      them; 'allowed-tools' holds the one shape this repo departs to.
#   5. The SKILL.md body stays inside the recommended budget.
#   6. Bundled-file references resolve, stay one level deep, and use forward
#      slashes; long reference files carry a table of contents.
#
# An optional first argument overrides the repo root, so the fixture harness
# can point this at a mutated copy of the repo.
set -euo pipefail

if [ $# -ge 1 ]; then
	REPO_ROOT="$(cd "$1" && pwd)"
else
	REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi

PYTHONDONTWRITEBYTECODE=1 PYTHONSAFEPATH=1 PYTHONPATH="$(cd "$(dirname "$0")" && pwd)" python3 - "$REPO_ROOT" <<'PY'
import os
import re
import sys

from _common import bad, error_count, ok, parse_frontmatter, skill_files, split_frontmatter

root = sys.argv[1]

# ---------------------------------------------------------------- the policy

# https://agentskills.io/specification -- the whole of it.
STANDARD_FIELDS = {
    "name",
    "description",
    "license",
    "compatibility",
    "metadata",
    "allowed-tools",
}

NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
NAME_MAX = 64
# The standard's hard ceiling.
DESCRIPTION_MAX = 1024
# This repo's own ceiling. A description is loaded in every session, whether
# or not its skill fires, so v3 holds it to one short sentence.
DESCRIPTION_PREFERRED_MAX = 160
COMPATIBILITY_MAX = 500
# A body is read in full each time its skill runs. v3 budgets it well under
# the standard's 500: one purpose fits in 100 lines, and the coordinator,
# which names every other skill, gets 150. What only some runs need moves to
# references/, where it is read only when the body says so.
BODY_MAX_LINES = 100
BODY_MAX_LINES_FOR = {"smith": 150}
# A reference file past this length gets previewed rather than read whole, so
# it needs a contents list for the preview to still show its full scope.
TOC_REQUIRED_OVER = 100

RESERVED_WORDS = ("anthropic", "claude")
XML_TAG_RE = re.compile(r"<[a-zA-Z/][^>]*>")
# "I can help you...", "You can use this to..." -- the description is injected
# into the system prompt, where a shifting point of view hurts discovery.
FIRST_SECOND_PERSON_RE = re.compile(r"^\s*(I\b|I'|You\b|Your\b|We\b|Our\b|This skill\b)")
MD_LINK_RE = re.compile(r"\[[^\]]*\]\(([^)]+)\)")


# --------------------------------------------------------------- the checks


def rel(path):
    return os.path.relpath(path, root)


def check_fields(label, fields):
    for key in fields:
        if key in STANDARD_FIELDS:
            continue
        bad(f"{label}: unknown frontmatter key '{key}' (allowed: the six standard fields)")
    for key in ("name", "description"):
        if not fields.get(key):
            bad(f"{label}: required field '{key}' is missing or empty")


def check_name(label, fields, skill_dir):
    name = fields.get("name")
    if not isinstance(name, str) or not name:
        return
    if len(name) > NAME_MAX:
        bad(f"{label}: name is {len(name)} characters, over the {NAME_MAX} limit")
    if not NAME_RE.match(name):
        bad(
            f"{label}: name '{name}' must be lowercase letters, numbers and single"
            " hyphens, and may not start or end with one"
        )
    for word in RESERVED_WORDS:
        if word in name.lower():
            bad(f"{label}: name '{name}' contains the reserved word '{word}'")
    expected = os.path.basename(skill_dir)
    if name != expected:
        bad(f"{label}: name '{name}' does not match its directory '{expected}'")


def check_description(label, fields):
    desc = fields.get("description")
    if not isinstance(desc, str) or not desc:
        return
    if len(desc) > DESCRIPTION_MAX:
        bad(f"{label}: description is {len(desc)} characters, over the {DESCRIPTION_MAX} limit")
    elif len(desc) > DESCRIPTION_PREFERRED_MAX:
        bad(
            f"{label}: description is {len(desc)} characters, over this repo's"
            f" {DESCRIPTION_PREFERRED_MAX} limit -- it is"
            " loaded in every session, so it stays one short sentence"
        )
    if XML_TAG_RE.search(desc):
        bad(f"{label}: description contains an XML tag, which the standard forbids")
    if FIRST_SECOND_PERSON_RE.match(desc):
        bad(
            f"{label}: description must be third person ('Reviews code...'),"
            " not first or second ('I can help you...', 'This skill...')"
        )


# allowed-tools departs from the standard's space-separated string: a grant like
# Bash(git status:*) holds a space, and a string would silently drop it.
def check_shapes(label, fields):
    compat = fields.get("compatibility")
    if compat is not None:
        if not isinstance(compat, str):
            bad(f"{label}: compatibility must be a string")
        elif len(compat) > COMPATIBILITY_MAX:
            bad(f"{label}: compatibility is {len(compat)} characters, over the {COMPATIBILITY_MAX} limit")

    meta = fields.get("metadata")
    if meta is not None:
        if not isinstance(meta, dict):
            bad(f"{label}: metadata must be a mapping")
        else:
            for k, v in meta.items():
                if v is None or v == "":
                    bad(f"{label}: metadata.{k} must hold a string value")

    tools = fields.get("allowed-tools")
    if tools is not None and not isinstance(tools, list):
        bad(
            f"{label}: allowed-tools must be a YAML list, not a string"
            " -- see the note above check_shapes for why this one field"
            " deliberately departs from the standard's type"
        )


def check_body(label, path, body):
    limit = BODY_MAX_LINES_FOR.get(os.path.basename(os.path.dirname(path)), BODY_MAX_LINES)
    if len(body) > limit:
        bad(
            f"{label}: body is {len(body)} lines, over its {limit}-line budget"
            " -- shorten it, or move what only some runs need into references/"
        )

    skill_dir = os.path.dirname(path)
    first_level = []
    for target in MD_LINK_RE.findall("\n".join(body)):
        if target.startswith(("http://", "https://", "#", "mailto:")):
            continue
        if "\\" in target:
            bad(f"{label}: reference '{target}' uses backslashes; use forward slashes everywhere")
            continue
        resolved = os.path.normpath(os.path.join(skill_dir, target.split("#")[0]))
        if not os.path.exists(resolved):
            bad(f"{label}: reference '{target}' does not resolve to a bundled file")
        elif resolved.endswith(".md"):
            first_level.append((target, resolved))

    for target, resolved in first_level:
        ref_lines = open(resolved, encoding="utf-8").read().splitlines()
        if len(ref_lines) > TOC_REQUIRED_OVER and not any(
            re.match(r"^#{1,3}\s+(Contents|Table of contents)\s*$", l, re.I) for l in ref_lines
        ):
            bad(
                f"{label}: '{target}' is {len(ref_lines)} lines and needs a"
                " '## Contents' list, so a partial read still shows its scope"
            )
        for nested in MD_LINK_RE.findall("\n".join(ref_lines)):
            if nested.startswith(("http://", "https://", "#", "mailto:")):
                continue
            if os.path.normpath(os.path.join(os.path.dirname(resolved), nested.split("#")[0])).endswith(".md"):
                bad(
                    f"{label}: '{target}' links on to '{nested}'. Keep every reference"
                    " one level deep from SKILL.md, or a partial read loses the trail"
                )


# ------------------------------------------------------------------- the run

print("==> Checking SKILL.md against the Agent Skills standard")
paths = skill_files(root)
# An empty glob is a layout the check no longer understands -- unless the
# marketplace registers no plugin at all, which is a repo with nothing to ship.
if not paths:
    import json
    with open(os.path.join(root, ".claude-plugin", "marketplace.json")) as f:
        registered = json.load(f).get("plugins", [])
    if registered:
        bad("no SKILL.md found under plugins/*/skills/*/")

for path in paths:
    label = rel(path)
    front, body = split_frontmatter(path)
    if front is None:
        bad(f"{label}: frontmatter is missing or its closing '---' is absent")
        continue
    fields = parse_frontmatter(front)
    check_fields(label, fields)
    check_name(label, fields, os.path.dirname(path))
    check_description(label, fields)
    check_shapes(label, fields)
    check_body(label, path, body)
    ok(label)

if error_count():
    print(f"==> {error_count()} standard violation(s)")
    sys.exit(1)
print("==> All skills follow the Agent Skills standard")
PY
