*.sw[po]

# smith writes PLAN.md and PLAN_DETAILS.md at the repo root as the living plan for
# the current piece of work, and removes them after the merge. Never committed.
PLAN.md
PLAN_DETAILS.md

# `make eval` writes aggregate-result.json and an HTML report per run into the
# plugin it evaluated. They are run artefacts of a paid, machine-local check,
# not repo contents.
plugins/*/evals/results/
